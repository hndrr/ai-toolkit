#!/bin/sh

# Print a compare URL whose base repository is the user's fork. This avoids
# GitHub's default "compare & pull request" link, which may target upstream.
set -eu

origin_url="$(git remote get-url origin 2>/dev/null || true)"
repo_path="$(printf '%s\n' "$origin_url" \
  | sed -E \
      -e 's#^[^:/]+://[^/]+/##' \
      -e 's#^[^@]+@[^:]+:##' \
      -e 's#\.git/?$##' \
      -e 's#/$##' \
  | tr '[:upper:]' '[:lower:]')"

if [ "$repo_path" != "hndrr/ai-toolkit" ]; then
  exit 0
fi

branch="$(git branch --show-current)"
if [ -n "$branch" ]; then
  encoded_branch="$(printf '%s' "$branch" | sed 's#/#%2F#g')"
  echo "Safe fork PR URL: https://github.com/hndrr/ai-toolkit/compare/main...${encoded_branch}?expand=1"
fi
