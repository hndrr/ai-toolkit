#!/bin/sh

# This repository is a fork. Never allow a local push to the upstream project.
set -eu

remote_name="${1:-}"
remote_url="$(git remote get-url --push "$remote_name" 2>/dev/null || true)"

if [ "$remote_name" = "upstream" ]; then
  echo "Push blocked: the upstream remote is fetch-only." >&2
  echo "Push to origin (hndrr/ai-toolkit) instead." >&2
  exit 1
fi

repo_path="$(printf '%s\n' "$remote_url" \
  | sed -E \
      -e 's#^[^:/]+://[^/]+/##' \
      -e 's#^[^@]+@[^:]+:##' \
      -e 's#\.git/?$##' \
      -e 's#/$##' \
  | tr '[:upper:]' '[:lower:]')"

if [ "$repo_path" = "ostris/ai-toolkit" ]; then
  echo "Push blocked: upstream ostris/ai-toolkit is read-only for this checkout." >&2
  echo "Push to the fork hndrr/ai-toolkit instead." >&2
  exit 1
fi

exit 0
